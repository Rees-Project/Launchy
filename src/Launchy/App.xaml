<Application x:Class="Launchy.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4F8BFF" Offset="0" />
            <GradientStop Color="#A35CFF" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WordmarkGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#C3CCFF" Offset="1" />
        </LinearGradientBrush>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="Background" Value="#2C2E35" />
            <Setter Property="BorderBrush" Value="#44FFFFFF" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3A3D46" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2F6FDE" />
            <Setter Property="BorderBrush" Value="#2F6FDE" />
        </Style>

        <!-- The logo's "L": a bent arrow. Shared by the wordmark and the tray icon. -->
        <Geometry x:Key="LogoArrowGeometry">M0,0 H6 V22 H15 V18 L23,25 L15,32 V28 H0 Z</Geometry>
    </Application.Resources>
</Application>
