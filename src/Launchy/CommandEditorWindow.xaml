<Window x:Class="Launchy.CommandEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Launchy"
        Title="Launchy — Commands"
        Width="960" Height="560" MinWidth="640" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="#1E1F24">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="Background" Value="#2C2E35" />
            <Setter Property="CaretBrush" Value="#F2F2F2" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#1E1F24" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#26282E" />
            <Setter Property="Foreground" Value="#9AA0A6" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2F4A6E" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Viewbox Height="30">
                <local:LogoMark />
            </Viewbox>
            <Border Width="1" Height="20" Background="#33FFFFFF" Margin="14,0" VerticalAlignment="Center" />
            <TextBlock Text="Commands" FontSize="20" FontWeight="SemiBold"
                       Foreground="#F2F2F2" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Foreground="#9AA0A6" Margin="0,0,0,12" TextWrapping="Wrap"
                   Text="Double-click a cell to edit it. Locations can use variables such as %APPDATA%. Nothing is written until you press Save." />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Add" Click="Add_Click" />
            <Button DockPanel.Dock="Left" Content="Delete" Click="Delete_Click" />
            <Button DockPanel.Dock="Left" Content="Import…" Click="Import_Click" />
            <Button DockPanel.Dock="Left" Content="Export…" Click="Export_Click" />
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Margin="8,0" Foreground="#E8A33D" TextTrimming="CharacterEllipsis" />
            <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource PrimaryButton}"
                    Margin="0" Click="Save_Click" />
            <Button DockPanel.Dock="Right" Content="Cancel" Click="Cancel_Click" />
        </DockPanel>

        <DataGrid x:Name="CommandsGrid"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True"
                  SelectionMode="Extended" HeadersVisibility="Column" RowHeight="30"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1FFFFFFF"
                  Background="#1E1F24" RowBackground="#1E1F24" AlternatingRowBackground="#23252B"
                  Foreground="#F2F2F2" BorderBrush="#33FFFFFF" BorderThickness="1"
                  CellEditEnding="CommandsGrid_CellEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Command" Width="150" Binding="{Binding Command}" />
                <DataGridComboBoxColumn x:Name="TypeColumn" Header="Type" Width="120"
                                        SelectedItemBinding="{Binding Type}" />
                <DataGridTextColumn Header="Location" Width="*" Binding="{Binding Location}" />
                <DataGridTextColumn Header="Parameters" Width="200" Binding="{Binding Parameters}" />
                <DataGridCheckBoxColumn Header="Admin" Width="70" Binding="{Binding RunAsAdmin}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
