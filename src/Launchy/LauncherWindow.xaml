<Window x:Class="Launchy.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Launchy"
        Title="Launchy"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Height"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="#9AA0A6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="4" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2C2E35" />
                                <Setter Property="Foreground" Value="#F2F2F2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="16" CornerRadius="12" Padding="16,12"
            Background="#1E1F24" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5" />
        </Border.Effect>
        <StackPanel>
            <DockPanel Margin="0,0,0,8" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Height="24" Margin="3,0,0,0">
                        <local:LogoMark />
                    </Viewbox>
                    <Border Width="1" Height="14" Background="#33FFFFFF" Margin="12,0,6,0" />
                    <Button Content="Edit" Style="{StaticResource HeaderButton}" Margin="0"
                            ToolTip="Add, edit or remove commands" Click="Edit_Click" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource HeaderButton}"
                        ToolTip="Close (Esc)" Click="Close_Click" />
            </DockPanel>
            <Border Height="1" Background="#22FFFFFF" Margin="0,0,0,10" />
            <Grid>
                <TextBlock x:Name="Placeholder" Text="Type a command"
                           FontSize="22" Foreground="#5F6368" Margin="3,0,0,0"
                           IsHitTestVisible="False" />
                <TextBox x:Name="CommandBox"
                         FontSize="22" Foreground="#F2F2F2" CaretBrush="#F2F2F2"
                         Background="Transparent" BorderThickness="0"
                         TextChanged="CommandBox_TextChanged"
                         PreviewKeyDown="CommandBox_PreviewKeyDown" />
            </Grid>
            <TextBlock x:Name="StatusText" Margin="3,6,0,0" FontSize="12"
                       Foreground="#9AA0A6" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Border>
</Window>
