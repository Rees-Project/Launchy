<Window x:Class="Launchy.WorkspaceProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launchy — Starting workspace"
        Width="340" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True" Focusable="False"
        AutomationProperties.Name="Workspace progress">
    <Border Background="#1E1F24" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,12">
        <StackPanel>
            <TextBlock x:Name="TitleText" Foreground="#F2F2F2" FontWeight="SemiBold" FontSize="14"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="SubtitleText" Foreground="#9AA0A6" FontSize="12" Margin="0,2,0,8" />
            <ItemsControl x:Name="RowsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" Foreground="{Binding Brush}" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#F2F2F2"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       ToolTip="{Binding Detail}" />
                            <TextBlock Grid.Column="2" Text="{Binding StateText}" Foreground="{Binding Brush}"
                                       FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="CancelButton" Content="Cancel" HorizontalAlignment="Right" Margin="0,10,0,0"
                    Click="Cancel_Click" AutomationProperties.Name="Cancel workspace start" />
        </StackPanel>
    </Border>
</Window>
