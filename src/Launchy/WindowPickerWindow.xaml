<Window x:Class="Launchy.WindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Launchy"
        Title="Launchy — Capture layout"
        Width="780" Height="620" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="#1E1F24"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
        <Style x:Key="RowBorder" TargetType="Border">
            <Setter Property="Background" Value="#23252B" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Viewbox Height="30">
                <local:LogoMark />
            </Viewbox>
            <Border Width="1" Height="20" Background="#33FFFFFF" Margin="14,0" VerticalAlignment="Center" />
            <TextBlock Text="Capture layout" FontSize="20" FontWeight="SemiBold"
                       Foreground="#F2F2F2" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Foreground="#9AA0A6" Margin="0,0,0,12" TextWrapping="Wrap"
                   Text="Tick the windows to save. Ticked windows save their position. Capture cannot read program arguments or website addresses; type them in the editor." />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="#E8A33D" TextWrapping="Wrap" MaxWidth="420" />
            <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource PrimaryButton}"
                    Margin="0" Click="Save_Click" />
            <Button DockPanel.Dock="Right" Content="Cancel" Click="Cancel_Click" />
            <Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click"
                    ToolTip="Read the open windows again" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel x:Name="ItemsSection">
                    <TextBlock Text="Workspace items" Style="{StaticResource SectionHeader}" />
                    <ItemsControl x:Name="ItemRowsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding HasWindow}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Description}" Foreground="#F2F2F2"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SingleWindowText}" Foreground="#9AA0A6" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding ShowSingleWindowText, Converter={StaticResource BoolToVisibility}}" />
                                            <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding Selected}"
                                                      DisplayMemberPath="Text" Margin="0,4,0,0"
                                                      SelectionChanged="ItemWindow_SelectionChanged"
                                                      Visibility="{Binding HasChoice, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding Hint}" Foreground="#E8A33D" FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Other windows (ticked windows become new items)" Style="{StaticResource SectionHeader}"
                               Margin="0,12,0,8" />
                </StackPanel>

                <ItemsControl x:Name="WindowRowsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RowBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsCapturable}" />
                                    <Image Grid.Column="1" Source="{Binding Icon}" Width="24" Height="24"
                                           Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Title}" Foreground="#F2F2F2" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding AppName}" Foreground="#9AA0A6" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Hint}" Foreground="#E8A33D" FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding Monitor}" Foreground="#9AA0A6"
                                               FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoWindowsText" Text="No other open windows." Foreground="#9AA0A6"
                           Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
