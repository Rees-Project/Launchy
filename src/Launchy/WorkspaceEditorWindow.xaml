<Window x:Class="Launchy.WorkspaceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Launchy"
        Title="Launchy — Workspaces"
        Width="1100" Height="680" MinWidth="820" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="#1E1F24">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="Background" Value="#2C2E35" />
            <Setter Property="CaretBrush" Value="#F2F2F2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#1E1F24" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#26282E" />
            <Setter Property="Foreground" Value="#9AA0A6" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2F4A6E" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#23252B" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA0A6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Viewbox Height="30">
                <local:LogoMark />
            </Viewbox>
            <Border Width="1" Height="20" Background="#33FFFFFF" Margin="14,0" VerticalAlignment="Center" />
            <TextBlock Text="Workspaces" FontSize="20" FontWeight="SemiBold"
                       Foreground="#F2F2F2" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Foreground="#9AA0A6" Margin="0,0,0,12" TextWrapping="Wrap"
                   Text="A workspace opens all of its items together. Capture layout saves where each window sits. Test run starts every item as a new window. Nothing is written until you press Save." />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="#E8A33D" TextWrapping="Wrap" MaxWidth="700" />
            <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource PrimaryButton}"
                    Margin="0" Click="Save_Click" />
            <Button DockPanel.Dock="Right" Content="Cancel" Click="Cancel_Click" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Left" Width="210" Margin="0,0,16,0">
            <WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="New" Click="NewWorkspace_Click" Padding="12,6" />
                <Button Content="Delete" Click="DeleteWorkspace_Click" Padding="12,6" />
                <Button Content="Import…" Click="ImportWorkspaces_Click" Padding="12,6" />
                <Button Content="Export…" Click="ExportWorkspaces_Click" Padding="12,6" />
            </WrapPanel>
            <ListBox x:Name="WorkspaceList" DisplayMemberPath="Name"
                     AutomationProperties.Name="Workspaces"
                     SelectionChanged="WorkspaceList_SelectionChanged" />
        </DockPanel>

        <Grid x:Name="EditPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Left" Text="Name" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" AutomationProperties.Name="Workspace name"
                         TextChanged="NameBox_TextChanged" />
            </DockPanel>

            <DataGrid x:Name="ItemsGrid" Grid.Row="1"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Extended" HeadersVisibility="Column" RowHeight="30"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1FFFFFFF"
                      Background="#1E1F24" RowBackground="#1E1F24" AlternatingRowBackground="#23252B"
                      Foreground="#F2F2F2" BorderBrush="#33FFFFFF" BorderThickness="1"
                      AutomationProperties.Name="Workspace items"
                      CellEditEnding="ItemsGrid_CellEditEnding">
                <DataGrid.Columns>
                    <DataGridComboBoxColumn x:Name="TypeColumn" Header="Type" Width="110"
                                            SelectedItemBinding="{Binding Type}" />
                    <DataGridTextColumn Header="Location" Width="*" Binding="{Binding Location}" />
                    <DataGridTextColumn Header="Parameters" Width="160" Binding="{Binding Parameters}" />
                    <DataGridTextColumn Header="Placement" Width="200" IsReadOnly="True"
                                        Binding="{Binding PlacementSummary, Mode=OneWay}" />
                    <DataGridTextColumn Header="Timeout (s)" Width="90" Binding="{Binding TimeoutSeconds}" />
                    <DataGridComboBoxColumn x:Name="IfRunningColumn" Header="If running" Width="100"
                                            SelectedItemBinding="{Binding IfRunning}" />
                    <DataGridCheckBoxColumn Header="Front" Width="60" Binding="{Binding Focus}" />
                    <DataGridCheckBoxColumn Header="New window" Width="90" Binding="{Binding NewWindow}" />
                </DataGrid.Columns>
            </DataGrid>

            <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                <Button Content="Add item" Click="AddItem_Click" Margin="0,0,8,4" />
                <Button Content="Remove item" Click="RemoveItem_Click" Margin="0,0,8,4" />
                <Button Content="Move up" Click="MoveUp_Click" Margin="0,0,8,4" />
                <Button Content="Move down" Click="MoveDown_Click" Margin="0,0,8,4" />
                <Button Content="Capture layout…" Click="Capture_Click" Margin="0,0,8,4"
                        ToolTip="Pick open windows and save their positions into this workspace" />
                <Button x:Name="TestRunButton" Content="Test run" Click="TestRun_Click" Margin="0,0,8,4"
                        ToolTip="Start every item now, as new windows, and place them" />
            </WrapPanel>

            <Border Grid.Row="3" Background="#23252B" BorderBrush="#33FFFFFF" BorderThickness="1"
                    CornerRadius="6" Padding="10,6" Height="88">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ResultsText" Foreground="#C9CDD2" TextWrapping="Wrap"
                               AutomationProperties.Name="Test run results"
                               Text="Test run results appear here." />
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
